{
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "ES2015",
      "DOM"
    ],
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "strict": true,
    "typeRoots": [
      "./src/typings",
      "./node_modules/@types"
    ],
    "downlevelIteration": true,
    "noEmit": true,
    "target": "ES5",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}